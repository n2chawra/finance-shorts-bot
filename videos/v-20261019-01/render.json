    "lines": [
      {
        "scene": "hook",
        "text": "The energy price cap means my bill is capped, right?",
        "start": 0.27,
        "seconds": 2.44,
        "window": 2.87,
        "fill": 0.85
      },
      {
        "scene": "headline",
        "text": "Ofgem's cap just went up £60, to £1,723 a year. But that is not a limit on your bill.",
        "start": 3.13,
        "seconds": 7.16,
        "window": 7.57,
        "fill": 0.946
      },
      {
        "scene": "actually",
        "text": "The cap limits the price of each unit of energy, and the daily standing charge.",
        "start": 10.7,
        "seconds": 4.26,
        "window": 4.73,
        "fill": 0.901
      },
      {
        "scene": "typical",
        "text": "That headline figure is just for a typical home, using a typical amount of energy.",
        "start": 15.43,
        "seconds": 4.64,
        "window": 5.07,
        "fill": 0.915
      },
      {
        "scene": "more",
        "text": "Use more, in a cold home or working from home, and your bill could be 25% higher: £2,154.",
        "start": 20.5,
        "seconds": 7.48,
        "window": 7.97,
        "fill": 0.939
      },
      {
        "scene": "extra",
        "text": "That is £431 extra a year, at the very same capped prices.",
        "start": 28.47,
        "seconds": 4.54,
        "window": 4.9,
        "fill": 0.927
      },
      {
        "scene": "rule",
        "text": "The cap fixes the price. Your usage sets the bill.",
        "start": 33.37,
        "seconds": 2.75,
        "window": 3.37,
        "fill": 0.816
      },
      {
        "scene": "outro",
        "text": "Now you know what the cap really caps.",
