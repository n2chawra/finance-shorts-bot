      {
        "scene": "hook",
        "text": "20.4%. That is how much US energy prices rose in one year.",
        "start": 0.27,
        "seconds": 4.25,
        "window": 4.87,
        "fill": 0.873
      },
      {
        "scene": "headline",
        "text": "But the official rate for all prices, in the same report, was just 3.7%.",
        "start": 5.13,
        "seconds": 4.63,
        "window": 5.27,
        "fill": 0.879
      },
      {
        "scene": "rohan",
        "text": "Then why does filling up my car feel so much worse?",
        "start": 10.4,
