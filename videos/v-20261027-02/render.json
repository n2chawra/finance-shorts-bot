    "lines": [
      {
        "scene": "hook",
        "text": "His bonus bought a TV. Mine bought a slice of the companies selling it.",
        "start": 0.27,
        "seconds": 2.9,
        "window": 3.43,
        "fill": 0.845
      },
      {
        "scene": "promise",
        "text": "Both got $5,000. Three check-ins, and the last one stings.",
        "start": 3.7,
        "seconds": 3.17,
        "window": 3.73,
        "fill": 0.85
      },
      {
        "scene": "spend",
        "text": "I went straight to the store. Biggest screen they had, plus a sound bar. Bonus, gone in a day.",
        "start": 7.43,
        "seconds": 3.73,
        "window": 4.0,
        "fill": 0.932
      },
      {
        "scene": "invest",
        "text": "I put mine in an index fund. A tiny slice of a whole market of companies, the TV shops included.",
        "start": 11.43,
        "seconds": 4.4,
        "window": 4.93,
        "fill": 0.892
      },
      {
        "scene": "check1",
        "text": "Check-in one, after 10 years. At an assumed 7% a year, my bonus is $9,836.",
        "start": 16.37,
        "seconds": 5.31,
        "window": 5.9,
        "fill": 0.9
      },
      {
        "scene": "tv1",
        "text": "Meanwhile, my TV? Scratched, slow, and nobody wants to buy it.",
        "start": 22.27,
        "seconds": 2.64,
        "window": 2.97,
        "fill": 0.889
      },
      {
        "scene": "check2",
        "text": "Check-in two, 20 years in: $19,348. And my money tree is speeding up.",
        "start": 25.23,
        "seconds": 4.71,
        "window": 5.27,
        "fill": 0.894
      },
      {
        "scene": "tv2",
        "text": "My TV finally died. Straight into the bin.",
        "start": 30.5,
        "seconds": 1.76,
        "window": 2.2,
        "fill": 0.8
      },
      {
        "scene": "check3",
        "text": "Check-in three, 30 years: $38,061. That whole tree grew from one bonus I never touched.",
        "start": 32.7,
        "seconds": 4.96,
        "window": 5.53,
        "fill": 0.897
      },
      {
        "scene": "turn",
        "text": "So that TV never really cost $5,000. It cost Rohan $38,061.",
