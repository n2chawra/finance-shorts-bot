    "lines": [
      {
        "scene": "hook",
        "text": "You think money builds any city? Not this one. Here's why.",
        "start": 0.3,
        "seconds": 2.87,
        "window": 3.5,
        "fill": 0.82
      },
      {
        "scene": "promise",
        "text": "Saudi Arabia planned The Line, one straight city 170 kilometres long.",
        "start": 3.8,
        "seconds": 4.36,
        "window": 5.0,
        "fill": 0.872
      },
      {
        "scene": "people",
        "text": "It was meant to house 1.5M people by the end of the decade.",
        "start": 8.8,
        "seconds": 3.83,
        "window": 4.5,
        "fill": 0.851
      },
      {
        "scene": "ask",
        "text": "Neom's reported price tag: $1.5T. So what could stop it?",
        "start": 13.3,
        "seconds": 4.85,
        "window": 5.2,
        "fill": 0.933
      },
      {
        "scene": "build",
        "text": "Every kilometre has to be dug, poured and glassed in. So how far did they get?",
        "start": 18.5,
        "seconds": 4.14,
        "window": 4.73,
        "fill": 0.875
      },
      {
        "scene": "turn",
        "text": "Then the plan was cut: just 2.4 kilometres this decade, 1.4% of the line. Now even that is on hold.",
        "start": 23.23,
        "seconds": 7.18,
        "window": 7.83,
        "fill": 0.917
      },
      {
        "scene": "payoff",
        "text": "Because a price tag of $1.5T is a plan, not money in the bank.",
        "start": 31.07,
        "seconds": 4.57,
        "window": 5.23,
        "fill": 0.874
      },
      {
        "scene": "loop",
        "text": "So, still think money builds any city?",
        "start": 36.3,
        "seconds": 1.94,
        "window": 2.5,
        "fill": 0.776
      }
    ]
