{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "myth_vs_fact script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template",
    "seed",
    "amount",
    "years",
    "tracks",
    "text"
  ],
  "properties": {
    "template": {
      "const": "myth_vs_fact"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "style": {
      "description": "Optional. Anything left out is picked from the seed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "enum": [
            "night",
            "forest",
            "plum",
            "ocean",
            "ember",
            "paper"
          ]
        },
        "genre": {
          "enum": [
            "lofi",
            "pop",
            "cinematic",
            "synthwave",
            "acoustic"
          ]
        },
        "key": {
          "enum": [
            "C",
            "C#",
            "D",
            "D#",
            "E",
            "F",
            "F#",
            "G",
            "G#",
            "A",
            "A#",
            "B"
          ]
        },
        "bpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 120
        }
      }
    },
    "amount": {
      "type": "integer",
      "minimum": 1000,
      "description": "One-time amount in rupees"
    },
    "years": {
      "type": "integer",
      "minimum": 2,
      "maximum": 40
    },
    "tracks": {
      "description": "Exactly two yearly growth rates applied to the same amount. First: what the myth relies on. Second: what it is up against (must be higher).",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "rate_pct"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 16
          },
          "rate_pct": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 30
          }
        }
      }
    },
    "text": {
      "description": "On-screen lines. No digits or rupee signs: numbers come from {placeholders} (see README.md).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "myth_line1",
        "myth_line2",
        "setup_title",
        "setup_note",
        "bust_line",
        "bust_sub",
        "race_title",
        "result_line1",
        "result_line2",
        "end_line1",
        "end_line2",
        "end_punch",
        "end_cta",
        "end_follow"
      ],
      "properties": {
        "myth_line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "myth_line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "setup_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "setup_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "bust_line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "bust_sub": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "race_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "result_line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "result_line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_punch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_cta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_follow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    }
  }
}
