{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "money_news script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template",
    "seed",
    "feed_id",
    "facts",
    "example",
    "text"
  ],
  "properties": {
    "template": {
      "const": "money_news"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "style": {
      "description": "Optional. Anything left out is picked from the seed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "enum": [
            "night",
            "forest",
            "plum",
            "ocean",
            "ember",
            "paper"
          ]
        },
        "genre": {
          "enum": [
            "lofi",
            "pop",
            "cinematic",
            "synthwave",
            "acoustic"
          ]
        },
        "key": {
          "enum": [
            "C",
            "C#",
            "D",
            "D#",
            "E",
            "F",
            "F#",
            "G",
            "G#",
            "A",
            "A#",
            "B"
          ]
        },
        "bpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 120
        }
      }
    },
    "feed_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "description": "The topic's id in improvement/research/topics.json. The number check compares `facts` with it."
    },
    "facts": {
      "description": "One to three sourced figures, copied exactly from the topic feed. The first is the headline figure.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value",
          "unit",
          "as_of",
          "source",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "pattern": "^[^0-9₹]*$",
            "description": "What the figure is, without digits, e.g. 'Monthly SIP inflows'"
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "enum": [
              "rupees",
              "rupees_lakh",
              "rupees_crore",
              "percent",
              "count",
              "count_lakh",
              "count_crore"
            ]
          },
          "as_of": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "source": {
            "type": "string",
            "minLength": 2,
            "maxLength": 24,
            "pattern": "^[^0-9₹]*$",
            "description": "Short publisher name shown on screen, e.g. 'AMFI', 'RBI'"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "example": {
      "description": "'What it means for you', computed by the template.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "amount",
        "years",
        "rate_pct"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sip",
            "lumpsum",
            "inflation"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 100
        },
        "years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "rate_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        }
      }
    },
    "text": {
      "description": "On-screen lines. No digits or rupee signs: numbers come from {placeholders} (see README.md).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline1",
        "headline2",
        "what_title",
        "why_title",
        "why_line1",
        "why_line2",
        "why_line3",
        "you_title",
        "you_line",
        "end_line1",
        "end_line2",
        "end_punch",
        "end_cta",
        "end_follow"
      ],
      "properties": {
        "headline1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "headline2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "what_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "why_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "why_line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "why_line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "why_line3": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "you_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "you_line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_punch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_cta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_follow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    }
  }
}
