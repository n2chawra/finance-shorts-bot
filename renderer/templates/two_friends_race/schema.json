{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "two_friends_race script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template",
    "seed",
    "monthly",
    "annual_return_pct",
    "end_age",
    "people",
    "text"
  ],
  "properties": {
    "template": {
      "const": "two_friends_race"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "style": {
      "description": "Optional. Anything left out is picked from the seed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "enum": [
            "night",
            "forest",
            "plum",
            "ocean",
            "ember",
            "paper"
          ]
        },
        "genre": {
          "enum": [
            "lofi",
            "pop",
            "cinematic",
            "synthwave",
            "acoustic"
          ]
        },
        "key": {
          "enum": [
            "C",
            "C#",
            "D",
            "D#",
            "E",
            "F",
            "F#",
            "G",
            "G#",
            "A",
            "A#",
            "B"
          ]
        },
        "bpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 120
        }
      }
    },
    "monthly": {
      "type": "integer",
      "minimum": 100,
      "description": "Monthly investment in rupees, same for both people"
    },
    "annual_return_pct": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 30
    },
    "end_age": {
      "type": "integer",
      "minimum": 30,
      "maximum": 80
    },
    "people": {
      "description": "Exactly two. First starts early, second starts later.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "start_age",
          "stop_age"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8
          },
          "start_age": {
            "type": "integer",
            "minimum": 18
          },
          "stop_age": {
            "type": "integer",
            "description": "Age at which contributions stop (money stays invested until end_age)"
          }
        }
      }
    },
    "text": {
      "description": "On-screen lines. No digits or rupee signs: numbers come from {placeholders} (see README.md).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook_title",
        "hook_sub",
        "hook_tease",
        "a_intro",
        "a_amount",
        "a_note",
        "b_intro",
        "b_amount",
        "b_note",
        "question_setup",
        "question",
        "question_cta",
        "chart_title",
        "chart_stop_label",
        "chart_note",
        "result_title",
        "result_line1",
        "result_line2",
        "end_line1",
        "end_line2",
        "end_punch",
        "end_pill",
        "end_cta",
        "end_follow"
      ],
      "properties": {
        "hook_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "hook_sub": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "hook_tease": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "a_intro": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "a_amount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "a_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "b_intro": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "b_amount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "b_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "question_setup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "question_cta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "chart_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "chart_stop_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "chart_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "result_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "result_line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "result_line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_punch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_pill": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_cta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_follow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    }
  }
}
