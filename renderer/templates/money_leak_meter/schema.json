{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "money_leak_meter script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template",
    "seed",
    "item",
    "cost",
    "times_per_month",
    "years",
    "annual_return_pct",
    "text"
  ],
  "properties": {
    "template": {
      "const": "money_leak_meter"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "style": {
      "description": "Optional. Anything left out is picked from the seed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "enum": [
            "night",
            "forest",
            "plum",
            "ocean",
            "ember",
            "paper"
          ]
        },
        "genre": {
          "enum": [
            "lofi",
            "pop",
            "cinematic",
            "synthwave",
            "acoustic"
          ]
        },
        "key": {
          "enum": [
            "C",
            "C#",
            "D",
            "D#",
            "E",
            "F",
            "F#",
            "G",
            "G#",
            "A",
            "A#",
            "B"
          ]
        },
        "bpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 120
        }
      }
    },
    "item": {
      "type": "string",
      "minLength": 2,
      "maxLength": 18,
      "description": "What the money goes on, lower case, e.g. 'food delivery'"
    },
    "cost": {
      "type": "integer",
      "minimum": 10,
      "description": "Rupees each time"
    },
    "times_per_month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "years": {
      "type": "integer",
      "minimum": 2,
      "maximum": 40
    },
    "annual_return_pct": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 30
    },
    "text": {
      "description": "On-screen lines. No digits or rupee signs: numbers come from {placeholders} (see README.md).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook_title",
        "hook_sub",
        "hook_tease",
        "leak_title",
        "leak_note",
        "meter_title",
        "meter_label",
        "flip_line1",
        "flip_line2",
        "grow_title",
        "cmp_title",
        "cmp_line",
        "end_line1",
        "end_line2",
        "end_punch",
        "end_cta",
        "end_follow"
      ],
      "properties": {
        "hook_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "hook_sub": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "hook_tease": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "leak_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "leak_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "meter_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "meter_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "flip_line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "flip_line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "grow_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "cmp_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "cmp_line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_punch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_cta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_follow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    }
  }
}
