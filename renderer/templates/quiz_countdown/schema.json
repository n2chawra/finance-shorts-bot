{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quiz_countdown script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template",
    "seed",
    "kind",
    "amount",
    "years",
    "annual_return_pct",
    "distractors",
    "text"
  ],
  "properties": {
    "template": {
      "const": "quiz_countdown"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "style": {
      "description": "Optional. Anything left out is picked from the seed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "enum": [
            "night",
            "forest",
            "plum",
            "ocean",
            "ember",
            "paper"
          ]
        },
        "genre": {
          "enum": [
            "lofi",
            "pop",
            "cinematic",
            "synthwave",
            "acoustic"
          ]
        },
        "key": {
          "enum": [
            "C",
            "C#",
            "D",
            "D#",
            "E",
            "F",
            "F#",
            "G",
            "G#",
            "A",
            "A#",
            "B"
          ]
        },
        "bpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 120
        }
      }
    },
    "kind": {
      "enum": [
        "sip",
        "lumpsum"
      ],
      "description": "sip: `amount` every month. lumpsum: `amount` once."
    },
    "amount": {
      "type": "integer",
      "minimum": 100
    },
    "years": {
      "type": "integer",
      "minimum": 2,
      "maximum": 40
    },
    "annual_return_pct": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 30
    },
    "distractors": {
      "description": "Two multipliers of the correct answer used for the wrong options.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0.2,
        "maximum": 3,
        "not": {
          "minimum": 0.85,
          "maximum": 1.15
        }
      }
    },
    "text": {
      "description": "On-screen lines. No digits or rupee signs: numbers come from {placeholders} (see README.md).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook_line",
        "q_title",
        "q_line1",
        "q_line2",
        "q_line3",
        "question",
        "q_cta",
        "opt_cta",
        "reveal_line",
        "reveal_note",
        "why_title",
        "why_line",
        "end_line1",
        "end_line2",
        "end_punch",
        "end_cta",
        "end_follow"
      ],
      "properties": {
        "hook_line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "q_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "q_line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "q_line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "q_line3": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "q_cta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "opt_cta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "reveal_line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "reveal_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "why_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "why_line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_punch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_cta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "end_follow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    }
  }
}
