{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "long_explainer script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template",
    "seed",
    "maths",
    "sections",
    "thumbnail"
  ],
  "properties": {
    "template": {
      "const": "long_explainer"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "style": {
      "description": "Optional. Anything left out is picked from the seed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "enum": [
            "night",
            "forest",
            "plum",
            "ocean",
            "ember",
            "paper"
          ]
        },
        "genre": {
          "enum": [
            "lofi",
            "pop",
            "cinematic",
            "synthwave",
            "acoustic"
          ]
        },
        "key": {
          "enum": [
            "C",
            "C#",
            "D",
            "D#",
            "E",
            "F",
            "F#",
            "G",
            "G#",
            "A",
            "A#",
            "B"
          ]
        },
        "bpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 120
        }
      }
    },
    "maths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "rate_pct",
          "years"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,23}$",
            "description": "Placeholder prefix, e.g. 'plan_a' gives {plan_a_final}"
          },
          "kind": {
            "enum": [
              "sip",
              "lumpsum",
              "fd",
              "inflation",
              "emi"
            ]
          },
          "monthly": {
            "type": "integer",
            "minimum": 100,
            "description": "sip only"
          },
          "amount": {
            "type": "integer",
            "minimum": 100,
            "description": "every kind except sip"
          },
          "rate_pct": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 30
          },
          "years": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "seconds",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "hook",
              "points",
              "number",
              "compare",
              "bars",
              "chart",
              "steps",
              "recap",
              "end"
            ]
          },
          "seconds": {
            "type": "number",
            "minimum": 12,
            "maximum": 90
          },
          "chapter": {
            "type": "string",
            "minLength": 2,
            "maxLength": 28,
            "pattern": "^[^0-9₹]*$"
          },
          "series": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string"
            },
            "description": "maths names, for 'bars' and 'chart'"
          },
          "field": {
            "enum": [
              "final",
              "invested",
              "gains",
              "emi",
              "total_paid"
            ],
            "description": "'bars': which computed value to plot"
          },
          "text": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "sub": {
                "type": "string",
                "minLength": 1,
                "maxLength": 110
              },
              "big": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "labels": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "x_label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "verdict": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "left_title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "left_value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "left_lines": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "right_title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "right_value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "right_lines": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "cta": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "channel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "assumption": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        }
      }
    },
    "thumbnail": {
      "description": "The thumbnail card: a few huge words and one figure. Keep it to 3-5 words a line.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line1"
      ],
      "properties": {
        "line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "line2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "big": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    }
  }
}
