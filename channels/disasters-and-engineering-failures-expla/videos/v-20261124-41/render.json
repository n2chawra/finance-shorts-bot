    "lines": [
      {
        "scene": "hook",
        "text": "Wind tore the Tacoma Narrows Bridge apart. How?",
        "start": 0.3,
        "seconds": 3.27,
        "window": 3.93,
        "fill": 0.832
      },
      {
        "scene": "gertie",
        "text": "It was four months old, and its builders called it Galloping Gertie.",
        "start": 4.23,
        "seconds": 3.94,
        "window": 4.57,
        "fill": 0.862
      },
      {
        "scene": "flaw",
        "text": "The flaw: solid steel plates down its sides, like a wall. The wind couldn't pass through.",
        "start": 8.8,
        "seconds": 5.54,
        "window": 6.2,
        "fill": 0.894
      },
      {
        "scene": "twist",
        "text": "That morning, the bouncing stopped. The deck began to twist. Why was that worse?",
        "start": 15.0,
        "seconds": 4.92,
        "window": 5.57,
        "fill": 0.883
      },
      {
        "scene": "feed",
        "text": "Each twist tipped an edge up, and the wind pushed it further. It fed itself.",
        "start": 20.57,
        "seconds": 4.88,
        "window": 5.47,
        "fill": 0.892
      },
      {
        "scene": "payoff",
        "text": "A 600-foot piece of deck fell into the water. No person died.",
        "start": 28.2,
        "seconds": 4.57,
        "window": 5.23,
        "fill": 0.874
      },
      {
        "scene": "change",
        "text": "Since then, long bridges are tested in wind tunnels first. Its replacement got an open truss.",
        "start": 33.43,
        "seconds": 6.54,
        "window": 7.23,
        "fill": 0.905
      },
      {
        "scene": "loop",
        "text": "Plates or truss: which would you drive across? Gertie had the plates.",
        "start": 40.67,
        "seconds": 4.1,
        "window": 4.77,
        "fill": 0.86
      }
    ]
  },
