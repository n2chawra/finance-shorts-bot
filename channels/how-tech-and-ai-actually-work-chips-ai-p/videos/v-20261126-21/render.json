    "lines": [
      {
        "scene": "hook",
        "text": "Why does this wing lift Airbus's superjumbo?",
        "start": 0.3,
        "seconds": 3.06,
        "window": 3.5,
        "fill": 0.874
      },
      {
        "scene": "myth",
        "text": "It isn't the reason you learned. Its wings span 79.8 metres. At school we learn air over the curved top must hurry to meet the air underneath.",
        "start": 3.8,
        "seconds": 10.7,
        "window": 11.27,
        "fill": 0.949
      },
      {
        "scene": "bust",
        "text": "Now follow two puffs of air through a wind tunnel. The top one reaches the back first. They never meet again.",
        "start": 15.07,
        "seconds": 7.49,
        "window": 7.87,
        "fill": 0.952
      },
      {
        "scene": "paper",
        "text": "And a flat paper plane, with no curved top at all, still flies. So what is a wing really doing?",
        "start": 22.93,
        "seconds": 6.38,
        "window": 6.73,
        "fill": 0.948
      },
      {
        "scene": "angle",
        "text": "It meets the air tilted up a little, and it turns the whole stream of air downward behind it.",
        "start": 29.67,
        "seconds": 5.76,
        "window": 6.13,
        "fill": 0.94
      },
      {
        "scene": "pressure",
        "text": "Air speeding over the top drops in pressure, the air below presses harder, and the wing is pushed up.",
        "start": 35.8,
        "seconds": 6.58,
        "window": 7.03,
        "fill": 0.936
      },
      {
        "scene": "newton",
        "text": "Push air down, and the air pushes the wing back up.",
