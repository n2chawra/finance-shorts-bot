    "lines": [
      {
        "scene": "hook",
        "text": "This hand-sized motor starts a whole car engine.",
        "start": 0.3,
        "seconds": 3.43,
        "window": 3.8,
        "fill": 0.903
      },
      {
        "scene": "key",
        "text": "Turn the key, and the solenoid, an electromagnet, snaps its plunger in.",
        "start": 4.1,
        "seconds": 4.9,
        "window": 5.33,
        "fill": 0.919
      },
      {
        "scene": "shove",
        "text": "That pulls a lever, shoving the pinion gear into the toothed ring on the flywheel.",
        "start": 9.43,
        "seconds": 4.77,
        "window": 5.37,
        "fill": 0.888
      },
      {
        "scene": "contacts",
        "text": "The plunger then bridges two copper contacts, and battery current floods the motor.",
        "start": 14.8,
        "seconds": 5.5,
        "window": 5.97,
        "fill": 0.921
      },
      {
        "scene": "teeth",
        "text": "But a motor this small can't turn an engine head-on. This pinion has 9 teeth. The ring has 135.",
        "start": 20.77,
        "seconds": 7.73,
        "window": 8.27,
        "fill": 0.935
      },
      {
        "scene": "payoff",
        "text": "So the pinion spins 15.0× for each turn of the engine, trading speed for force to drag the pistons round.",
        "start": 29.03,
        "seconds": 8.32,
        "window": 8.97,
        "fill": 0.928
      },
      {
        "scene": "release",
        "text": "Once the engine fires, a one-way clutch lets the pinion spin free. Let go of the key, and a spring pulls it back.",
        "start": 38.0,
        "seconds": 7.78,
        "window": 8.4,
        "fill": 0.926
      },
      {
        "scene": "history",
        "text": "Cadillac ordered 12,000 of Kettering's electric starters. Before, you cranked engines by hand.",
        "start": 46.4,
        "seconds": 6.89,
        "window": 7.43,
        "fill": 0.927
      },
      {
        "scene": "loop",
        "text": "Jet engine or wind turbine next? When you turn the key, think of this motor.",
        "start": 53.83,
        "seconds": 4.98,
        "window": 5.6,
        "fill": 0.889
      }
    ]
