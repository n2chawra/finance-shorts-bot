    { "id": "interest-starts", "scene": "monster", "transition": "zoom",
      "say": "Here is the catch. When you pay anything less than the total, interest starts on everything you still owe. Around {card_rate_month} every single month.",
      "events": { "rate": { "word": "Around" } },
      "sfx": [ { "kind": "riser", "at": "start", "gain": 0.4 }, { "kind": "pop", "at": "rate" } ],
      "params": { "label": "{card_rate_month} every month", "labelAt": "rate", "name": "INTEREST" } },

    { "id": "per-year", "scene": "bignumber", "transition": "slide",
      "say": "{card_rate_month} a month sounds small. But over a year, that is {card_rate_year}. A credit card is one of the most expensive ways to borrow money.",
      "events": { "year": { "word": "over" } },
      "sfx": [ { "kind": "boom", "at": "year", "gain": 0.6 } ],
      "params": {
        "lines": [
          { "text": "{card_rate_month} a month", "style": "sub", "at": "start" },
          { "text": "{card_rate_year} a year", "style": "danger", "at": "year" } ],
        "actor": { "who": "priya", "x": 0.82, "acting": [ { "sec": 0, "pose": "present", "expression": "thinking", "turn": -0.3 } ] } } },

    { "id": "snowball", "scene": "snowball", "transition": "wipe",
      "say": "And it compounds. This month's interest joins the balance, and next month you pay interest on that bigger number too. Like a snowball, rolling downhill.",
      "sfx": [ { "kind": "whoosh", "at": "start" } ],
      "params": { "label": "Interest on interest", "tick": "+ interest" } },

    { "id": "bite", "scene": "monster",
      "say": "So every time Rohan pays, interest takes the first big bite. Only what is left actually shrinks his debt.",
      "params": { "label": "Interest eats first", "name": "INTEREST" } },

    { "id": "ch3", "scene": "chapter", "transition": "wipe", "sfx": [ { "kind": "whoosh", "at": "start" } ],
