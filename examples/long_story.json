    { "id": "three", "scene": "stage", "speaker": "priya", "transition": "fade",
      "say": "Here is what to do instead. Three simple things.",
      "params": { "set": "home", "actors": [
        { "who": "rohan", "x": 0.27, "acting": [ { "sec": 0, "pose": "think", "expression": "thinking", "turn": 0.4 } ] },
        { "who": "priya", "x": 0.58, "acting": [ { "sec": 0, "pose": "present", "expression": "happy" } ] } ] } },

    { "id": "step1", "scene": "checklist", "speaker": "priya", "transition": "slide",
      "say": "One. Pay the total due every month, not the minimum. Set autopay for the full amount, so you never forget.",
      "params": { "title": "How to escape the trap", "active": 0,
        "items": [ { "text": "Pay the total due, every month", "icon": "autopay" }, { "text": "Can't? Convert it to an EMI", "icon": "emi" }, { "text": "Use it like a debit card", "icon": "debit" } ],
        "actor": { "who": "priya", "x": 0.84, "scale": 1.15, "acting": [ { "sec": 0, "pose": "present", "expression": "happy", "turn": -0.3 } ] } } },

    { "id": "step2", "scene": "checklist", "speaker": "priya",
      "say": "Two. If you really cannot pay it all, convert the purchase into an EMI. On this phone, a one year EMI at {emi_rate} costs about {emi_interest} in interest.",
      "params": { "title": "How to escape the trap", "active": 1,
        "items": [ { "text": "Pay the total due, every month", "icon": "autopay" }, { "text": "Can't? Convert it to an EMI", "icon": "emi" }, { "text": "Use it like a debit card", "icon": "debit" } ],
        "actor": { "who": "priya", "x": 0.84, "scale": 1.15, "acting": [ { "sec": 0, "pose": "thumbsUp", "expression": "smirk", "turn": -0.3 } ] } } },

    { "id": "step3", "scene": "checklist", "speaker": "priya",
      "say": "Three. Treat your credit card like a debit card. If the money is not in your account, do not swipe.",
      "params": { "title": "How to escape the trap", "active": 2,
        "items": [ { "text": "Pay the total due, every month", "icon": "autopay" }, { "text": "Can't? Convert it to an EMI", "icon": "emi" }, { "text": "Use it like a debit card", "icon": "debit" } ],
        "actor": { "who": "priya", "x": 0.84, "scale": 1.15, "acting": [ { "sec": 0, "pose": "hips", "expression": "proud", "turn": -0.3 } ] } } },

    { "id": "compare", "scene": "towers", "transition": "zoom",
