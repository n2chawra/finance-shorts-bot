      "params": { "lines": [
        { "text": "The minimum due", "style": "sub", "at": "start" },
        { "text": "keeps you paying", "style": "danger", "at": "keep" } ],
        "actor": {"who": "sharma", "x": 0.8, "scale": 1.2, "acting": [{"sec": 0, "pose": "hips", "expression": "smirk", "turn": -0.3}, {"at": "keep", "pose": "pointUp", "expression": "proud", "turn": -0.2}]} } },

    { "id": "ch5", "scene": "chapter", "transition": "wipe", "sfx": [ { "kind": "whoosh", "at": "start" } ],
